# Kick MCP Server Configuration
# 
# Authentication (pick one method):

# Option A: OAuth 2.1 App Access Token (recommended for public data)
# Create an app at https://kick.com/settings/developer
KICK_MCP_CLIENT_ID=
KICK_MCP_CLIENT_SECRET=

# Option B: Direct Bearer Token (if you already have one)
KICK_MCP_ACCESS_TOKEN=

# Server Configuration
KICK_MCP_HOST=127.0.0.1
KICK_MCP_PORT=10968
KICK_MCP_TRANSPORT=stdio

# Kick API
KICK_MCP_API_BASE_URL=https://api.kick.com
KICK_MCP_OAUTH_BASE_URL=https://id.kick.com
KICK_MCP_TIMEOUT=30

# MCP Bridge — comma-separated URLs to proxy additional MCP servers through this one
MCP_BRIDGE_URLS=
